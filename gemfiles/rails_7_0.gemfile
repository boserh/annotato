# frozen_string_literal: true

source "https://rubygems.org"

gemspec path: ".."

gem "activerecord", "~> 7.0.0"
gem "railties", "~> 7.0.0"
gem "sqlite3", "~> 1.4"
# Needed by Rails < 7.1 on Ruby 3.4
gem "base64"
gem "bigdecimal"
gem "concurrent-ruby", "< 1.3.5"
gem "drb"
gem "logger"
gem "mutex_m"

gem "rake", "~> 13.0"
gem "rspec", "~> 3.0"
gem "simplecov", require: false
